COASTER_ADMIN_PASSWORD=replace-with-a-long-random-password
COASTER_OPENAI_API_KEY=
COASTER_OPENAI_MODEL=gpt-5.6-sol
COASTER_RESEARCH_TIMEOUT_SECONDS=25
COASTER_RESEARCH_MAX_PAGE_BYTES=1500000
