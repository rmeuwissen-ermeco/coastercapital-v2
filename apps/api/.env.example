COASTER_ENVIRONMENT=development
COASTER_DATABASE_URL=sqlite:///./coastercapital.db
COASTER_CORS_ORIGINS=["http://localhost:3000"]
COASTER_JWT_SECRET=replace-with-at-least-32-random-characters
